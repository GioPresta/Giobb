# S2AT CENTRAL
z_s2at_central = z_runsettings.loc['Central', 'S2AT Name']
mv_central = float(i_s2at_grouped[z_s2at_central].iloc[0, 0])

for j in o_elenco_nrun[
        o_elenco_nrun['French Activation'] == 'Y'
    ]['RUN_NUMBER']:

    # S2AT associato alla sensitivity da RunSettings
    z_run = z_elenco_nrun.loc[j, 'RUN']
    z_s2at_name = z_runsettings.loc[z_run, 'S2AT Name']
    z_marketvalue = i_s2at_grouped[z_s2at_name]

    # Market Value associato allo shock da ShockSettings
    z_shock = z_elenco_nrun.loc[
        j, 'SOLVENCY_II_SHOCKS_PARAMETERS'
    ]
    z_mv_column = z_shocksettings.loc[
        z_shock, 'Market Value'
    ]

    z_mv_official = float(
        z_marketvalue['Market Value'].iloc[0]
    )

    z_mv_shock = float(
        z_marketvalue[z_mv_column].iloc[0]
    )

    # Coefficiente sensitivity
    coeff = (
        mv_central
        + (z_mv_official - mv_central)
    ) / mv_central

    # Shock BCC
    shock_value = 100 * (
        t_mfmathresif_mp_pool['ITU'][2]
        + (z_mv_shock - z_mv_official)
    ) / t_mfmathresif_mp_pool['ITU'][2]

    col_run = z_temp.columns.get_loc(j)

    # Riga MF_COEFF_SHOCK_UL_PC(2)
    z_temp.iloc[25, col_run] = float(shock_value) * float(coeff)

z_temp["Commentare"] = False