HEADERS_CHECK = [
    "MODELPOINT",
    "RIGA RPT",
    "TIPO",
    "PRODOTTO",
    "INIT_UNITS",
    "MF_INIT_UNITS(1)",
    "MF_INIT_UNITS(2)",
    "MF_INIT_UNITS(3)",
    "MF_INIT_UNITS(4)",
    "MF_INIT_UNITS(5)",
    "MF_INIT_UNITS(6)",
    "TOTALE UNITS",
    "PERCENTUALE EJ",
    "TOPUP ORIGINALE",
    "CALCOLO EXCEL",
    "TOPUP NUOVO RPT",
    "DIFFERENZA",
    "ESITO EXCEL",
    "CHECK PYTHON"
]


def intestazione_writeonly(ws, nomi):
    celle = []

    for nome in nomi:
        cella = WriteOnlyCell(
            ws, value=nome
        )

        cella.font = Font(
            bold=True,
            color="FFFFFF"
        )

        cella.fill = PatternFill(
            fill_type="solid",
            fgColor="17365D"
        )

        celle.append(cella)

    ws.append(celle)


def crea_check(coppie, percorso):

    # WRITE_ONLY ESCLUSIVAMENTE QUI
    wb = Workbook(write_only=True)

    # Riepilogo come primo foglio
    ws_riepilogo = wb.create_sheet(
        "RIEPILOGO"
    )

    # Dettaglio come secondo foglio
    ws = wb.create_sheet(
        "DETTAGLIO"
    )

    ws.freeze_panes = "E2"

    larghezze = [
        30, 12, 10, 18, 18,
        20, 20, 20, 20, 20, 20,
        19, 20, 21, 21, 21,
        20, 18, 18
    ]

    for j, larghezza in enumerate(
        larghezze, 1
    ):
        ws.column_dimensions[
            get_column_letter(j)
        ].width = larghezza

    intestazione_writeonly(
        ws,
        HEADERS_CHECK
    )

    numero_excel = 2

    righe_controllate = 0
    errori_calcolo = 0
    errori_struttura = []

    file_ok = 0
    file_ko = 0

    for numero_file, (originale, nuovo) in enumerate(
        coppie, 1
    ):

        nome = str(
            originale.relative_to(INPUT)
        )

        log(
            f"  CHECK [{numero_file}/{len(coppie)}] "
            f"{nome}"
        )

        tipo = tipo_modelpoint(
            originale.stem
        )

        old = leggi_righe(originale)
        new = leggi_righe(nuovo)

        try:
            header, colonne, ip, it, iu = (
                verifica_struttura(
                    old, new, nome, tipo
                )
            )

        except Exception as e:
            file_ko += 1
            errore = str(e)

            errori_struttura.append(errore)

            log(
                f"    ERRORE STRUTTURA: {errore}"
            )

            continue

        file_ok += 1

        for i in range(
            header + 1,
            len(old)
        ):
            a, _ = separa_riga(old[i])
            b, _ = separa_riga(new[i])

            if not a.strip():
                continue

            ca = a.split(b",")
            cb = b.split(b",")

            prodotto = testo(ca[ip])

            if prodotto not in PERCENTUALI:
                continue

            units = [
                dec(testo(ca[j]))
                for j in iu
            ]

            totale_units = sum(
                units, Decimal("0")
            )

            percentuale = PERCENTUALI[
                prodotto
            ]

            topup_originale = dec(
                testo(ca[it])
            )

            topup_nuovo = dec(
                testo(cb[it])
            )

            atteso = Decimal(
                nuovo_topup(
                    totale_units,
                    percentuale
                )
            )

            esito_python = (
                "OK"
                if atteso == topup_nuovo
                else "ERRORE"
            )

            if esito_python == "ERRORE":
                errori_calcolo += 1

            if tipo == "MO":
                init_units = float(
                    units[0]
                )

                multi = [None] * 6

            else:
                init_units = None

                multi = [
                    float(x)
                    for x in units
                ]

            r = numero_excel

            formula_units = (
                f'=IF(C{r}="MO",'
                f'E{r},SUM(F{r}:K{r}))'
            )

            formula_calcolo = (
                f"=ROUND("
                f"L{r}*M{r},"
                f"{DECIMALI_TOPUP})"
            )

            formula_differenza = (
                f"=O{r}-P{r}"
            )

            # Stessa tolleranza della precisione
            # scelta per il TOPUP.
            tolleranza = (
                Decimal("0.5")
                * Decimal("10") ** (
                    -DECIMALI_TOPUP
                )
            )

            formula_esito = (
                f'=IF(ABS(Q{r})<'
                f'{tolleranza},'
                f'"OK","ERRORE")'
            )

            if numero_excel > MAX_RIGHE_EXCEL:
                raise ValueError(
                    "CHECK: superato il limite "
                    "di righe Excel"
                )

            ws.append([
                nome,
                i + 1,
                tipo,
                prodotto,
                init_units,
                *multi,
                formula_units,
                float(percentuale),
                float(topup_originale),
                formula_calcolo,
                float(topup_nuovo),
                formula_differenza,
                formula_esito,
                esito_python
            ])

            numero_excel += 1
            righe_controllate += 1

            if (
                righe_controllate
                % OGNI_RIGHE == 0
            ):
                log(
                    f"    CHECK: "
                    f"{righe_controllate:,} righe "
                    f"| Errori: {errori_calcolo}"
                )

    # --------------------------------------------------------
    # FOGLIO RIEPILOGO
    # --------------------------------------------------------

    totale_errori = (
        errori_calcolo
        + len(errori_struttura)
    )

    esito_generale = (
        "OK"
        if totale_errori == 0
        else "NON OK"
    )

    intestazione_writeonly(
        ws_riepilogo,
        ["CONTROLLO", "RISULTATO"]
    )

    ws_riepilogo.append([
        "ESITO GENERALE",
        esito_generale
    ])

    ws_riepilogo.append([
        "FILE CONTROLLATI",
        len(coppie)
    ])

    ws_riepilogo.append([
        "FILE STRUTTURALMENTE OK",
        file_ok
    ])

    ws_riepilogo.append([
        "FILE CON ERRORI STRUTTURALI",
        file_ko
    ])

    ws_riepilogo.append([
        "RIGHE CONTROLLATE",
        righe_controllate
    ])

    ws_riepilogo.append([
        "ERRORI MATEMATICI",
        errori_calcolo
    ])

    ws_riepilogo.append([
        "DECIMALI TOPUP",
        DECIMALI_TOPUP
    ])

    ws_riepilogo.append([
        "NOTA",
        "Gli esiti Python sono disponibili "
        "subito; le formule Excel vengono "
        "ricalcolate all'apertura."
    ])

    ws_riepilogo.append([
        None, None
    ])

    intestazione_writeonly(
        ws_riepilogo,
        ["ERRORI STRUTTURALI", "DETTAGLIO"]
    )

    if not errori_struttura:
        ws_riepilogo.append([
            "NESSUNO",
            "OK"
        ])

    else:
        for n, errore in enumerate(
            errori_struttura, 1
        ):
            ws_riepilogo.append([
                f"ERRORE {n}",
                errore
            ])

    ws_riepilogo.column_dimensions[
        "A"
    ].width = 35

    ws_riepilogo.column_dimensions[
        "B"
    ].width = 90

    log("  Salvataggio CHECK in corso...")

    salva_excel_sicuro(
        wb, percorso
    )

    return {
        "righe": righe_controllate,
        "errori_calcolo": errori_calcolo,
        "errori_struttura": errori_struttura,
        "esito": esito_generale
    }


# ============================================================
# 7. EXCEL INDIVIDUALI - WORKBOOK NORMALE
# ============================================================

def converti_rpt_excel(sorgente, destinazione):
    righe = leggi_righe(sorgente)

    header, colonne = leggi_struttura(
        righe
    )

    # WORKBOOK NORMALE
    wb = Workbook()
    ws = wb.active

    ws.title = "MODELPOINT"
    ws.append(colonne)

    formato_intestazione(ws)

    conta = 0

    for riga in righe[header + 1:]:
        contenuto, _ = separa_riga(riga)

        if not contenuto.strip():
            continue

        campi = contenuto.split(b",")

        if len(campi) != len(colonne):
            raise ValueError(
                "Numero colonne non coerente"
            )

        if conta + 2 > MAX_RIGHE_EXCEL:
            raise ValueError(
                "Limite righe Excel superato"
            )

        ws.append([
            valore_excel(
                campo,
                colonne[j]
            )
            for j, campo in enumerate(campi)
        ])

        conta += 1

        if conta % OGNI_RIGHE == 0:
            log(
                f"    XLSX: {conta:,} righe"
            )

    ultima_colonna = get_column_letter(
        len(colonne)
    )

    ws.auto_filter.ref = (
        f"A1:{ultima_colonna}{ws.max_row}"
    )

    for j, nome in enumerate(
        colonne, 1
    ):
        ws.column_dimensions[
            get_column_letter(j)
        ].width = min(
            max(len(nome) + 2, 13),
            28
        )

    salva_excel_sicuro(
        wb, destinazione
    )

    return conta


# ============================================================
# 8. EXCEL COMPLESSIVI MONO E MULTI
# ============================================================

def crea_excel_complessivo(
    tipo,
    coppie,
    destinazione
):
    """
    Accoda tutti gli RPT modificati dello stesso tipo.

    Prima intestazione: inclusa.
    Intestazioni successive: escluse.

    Se le colonne sono diverse, segnala errore
    e non crea un file potenzialmente errato.
    """

    selezionati = [
        nuovo
        for originale, nuovo in coppie
        if tipo_modelpoint(
            originale.stem
        ) == tipo
    ]

    if not selezionati:
        log(
            f"  Nessun file {tipo} disponibile"
        )
        return 0, 0

    # Prima passata: verifica che tutte
    # le intestazioni siano compatibili.

    intestazione_riferimento = None

    for percorso in selezionati:
        righe = leggi_righe(percorso)

        _, colonne = leggi_struttura(
            righe
        )

        if intestazione_riferimento is None:
            intestazione_riferimento = colonne

        elif colonne != intestazione_riferimento:
            raise ValueError(
                "Intestazioni differenti tra "
                f"i file {tipo}. "
                f"File non compatibile: "
                f"{percorso.name}"
            )

    # WORKBOOK NORMALE, come richiesto.
    wb = Workbook()
    ws = wb.active

    ws.title = (
        "MONO" if tipo == "MO"
        else "MULTI"
    )

    ws.append(intestazione_riferimento)

    formato_intestazione(ws)

    righe_totali = 0

    for n, percorso in enumerate(
        selezionati, 1
    ):
        log(
            f"  {tipo} [{n}/{len(selezionati)}] "
            f"{percorso.name}"
        )

        righe = leggi_righe(percorso)

        header, colonne = leggi_struttura(
            righe
        )

        # Si parte sempre DOPO l'intestazione.
        # La prima intestazione e' gia' stata
        # scritta una sola volta in ws.append().

        for riga in righe[header + 1:]:
            contenuto, _ = separa_riga(riga)

            if not contenuto.strip():
                continue

            campi = contenuto.split(b",")

            if len(campi) != len(colonne):
                raise ValueError(
                    f"{percorso.name}: "
                    "numero colonne errato"
                )

            if (
                righe_totali + 2
                > MAX_RIGHE_EXCEL
            ):
                raise ValueError(
                    f"Complessivo {tipo}: "
                    "superato limite righe Excel"
                )

            ws.append([
                valore_excel(
                    campo,
                    colonne[j]
                )
                for j, campo in enumerate(campi)
            ])

            righe_totali += 1

            if righe_totali % OGNI_RIGHE == 0:
                log(
                    f"    {tipo} COMPLESSIVO: "
                    f"{righe_totali:,} righe"
                )

    ultima_colonna = get_column_letter(
        len(intestazione_riferimento)
    )

    ws.auto_filter.ref = (
        f"A1:{ultima_colonna}{ws.max_row}"
    )

    for j, nome in enumerate(
        intestazione_riferimento, 1
    ):
        ws.column_dimensions[
            get_column_letter(j)
        ].width = min(
            max(len(nome) + 2, 13),
            28
        )

    log(
        f"  Salvataggio complessivo {tipo}..."
    )

    salva_excel_sicuro(
        wb, destinazione
    )

    return len(selezionati), righe_totali


# ============================================================
# 9. PROGRAMMA PRINCIPALE
# ============================================================

def main():
    log("=" * 60)
    log("AVVIO ELABORAZIONE MODELPOINT")
    log("=" * 60)

    if not INPUT.is_dir():
        log(
            "ERRORE: cartella input non trovata"
        )
        return

    OUTPUT.mkdir(
        parents=True,
        exist_ok=True
    )

    XLSX_ORIGINALI.mkdir(
        parents=True,
        exist_ok=True
    )

    XLSX_MODIFICATI.mkdir(
        parents=True,
        exist_ok=True
    )

    files = sorted(
        p for p in INPUT.rglob("*")
        if p.is_file()
        and p.suffix.lower() == ".rpt"
    )

    totale = len(files)

    if totale == 0:
        log("Nessun file RPT trovato")
        return

    log(f"RPT trovati: {totale}")
    log(
        f"Decimali TOPUP: {DECIMALI_TOPUP}"
    )

    statistiche = defaultdict(list)

    errori = []
    nuovi = 0
    saltati = 0
    righe_modificate = 0

    # ========================================================
    # FASE 1/5 - MODIFICA RPT
    # ========================================================

    log("\nFASE 1/5 - MODIFICA RPT")

    for n, originale in enumerate(
        files, 1
    ):
        relativo = originale.relative_to(
            INPUT
        )

        destinazione = OUTPUT / relativo

        destinazione.parent.mkdir(
            parents=True,
            exist_ok=True
        )

        log(
            f"[{n}/{totale}] {relativo}"
        )

        if destinazione.exists():
            saltati += 1

            log(
                "  Gia' presente: "
                "nessuna sovrascrittura"
            )

            continue

        try:
            stats, righe = modifica_rpt(
                originale,
                destinazione
            )

            nuovi += 1
            righe_modificate += righe

            tipo = tipo_modelpoint(
                originale.stem
            )

            for prodotto, s in stats.items():
                statistiche[prodotto].append(
                    (
                        str(relativo),
                        tipo,
                        s
                    )
                )

            log(
                f"  RPT creato: "
                f"{righe:,} righe modificate"
            )

        except Exception as e:
            errori.append(
                (str(relativo), str(e))
            )

            log(f"  ERRORE: {e}")

    log("FASE 1 COMPLETATA")

    # ========================================================
    # FASE 2/5 - REPORT TXT
    # ========================================================

    log("\nFASE 2/5 - REPORT TXT")

    report = crea_report(
        statistiche,
        errori,
        nuovi,
        saltati,
        righe_modificate
    )

    log(
        f"REPORT TXT CREATO: {report}"
    )

    # ========================================================
    # PREPARAZIONE FILE DA CONTROLLARE
    # ========================================================

    coppie = []

    for originale in files:
        relativo = originale.relative_to(
            INPUT
        )

        modificato = OUTPUT / relativo

        if modificato.exists():
            coppie.append(
                (originale, modificato)
            )

    log(
        f"Coppie RPT disponibili: "
        f"{len(coppie)}"
    )

    # ========================================================
    # FASE 3/5 - CHECK EXCEL
    # ========================================================

    log("\nFASE 3/5 - CHECK EXCEL")

    percorso_check = nome_libero(
        "CHECK_CALCOLI.xlsx"
    )

    esito_check = "NON CREATO"

    try:
        risultato = crea_check(
            coppie,
            percorso_check
        )

        esito_check = risultato["esito"]

        log(
            f"CHECK CREATO: "
            f"{percorso_check}"
        )

        log(
            f"ESITO GENERALE: {esito_check}"
        )

        log(
            f"Righe controllate: "
            f"{risultato['righe']:,}"
        )

        log(
            f"Errori matematici: "
            f"{risultato['errori_calcolo']}"
        )

        log(
            f"Errori strutturali: "
            f"{len(risultato['errori_struttura'])}"
        )

    except Exception as e:
        log(f"ERRORE CREAZIONE CHECK: {e}")

    log("FASE 3 COMPLETATA")

    # ========================================================
    # FASE 4/5 - EXCEL INDIVIDUALI
    # ========================================================

    log(
        "\nFASE 4/5 - EXCEL ORIGINALI "
        "E MODIFICATI"
    )

    for n, (originale, modificato) in enumerate(
        coppie, 1
    ):
        relativo = originale.relative_to(
            INPUT
        )

        xlsx_originale = (
            XLSX_ORIGINALI / relativo
        ).with_suffix(".xlsx")

        xlsx_modificato = (
            XLSX_MODIFICATI / relativo
        ).with_suffix(".xlsx")

        log(
            f"[{n}/{len(coppie)}] "
            f"{relativo}"
        )

        operazioni = [
            (
                originale,
                xlsx_originale,
                "ORIGINALE"
            ),
            (
                modificato,
                xlsx_modificato,
                "MODIFICATO"
            )
        ]

        for sorgente, destinazione, etichetta in (
            operazioni
        ):
            if destinazione.exists():
                log(
                    f"  {etichetta}: "
                    "gia' presente"
                )

                continue

            destinazione.parent.mkdir(
                parents=True,
                exist_ok=True
            )

            try:
                righe = converti_rpt_excel(
                    sorgente,
                    destinazione
                )

                log(
                    f"  {etichetta} CREATO: "
                    f"{righe:,} righe"
                )

            except Exception as e:
                log(
                    f"  ERRORE {etichetta}: {e}"
                )

                errori.append(
                    (
                        str(relativo),
                        str(e)
                    )
                )

    log("FASE 4 COMPLETATA")

    # ========================================================
    # FASE 5/5 - EXCEL COMPLESSIVI
    # ========================================================

    log(
        "\nFASE 5/5 - EXCEL "
        "COMPLESSIVI MONO E MULTI"
    )

    for tipo, nome in [
        ("MO", "MONO_COMPLESSIVO.xlsx"),
        ("MU", "MULTI_COMPLESSIVO.xlsx")
    ]:

        percorso = nome_libero(nome)

        try:
            n_file, n_righe = (
                crea_excel_complessivo(
                    tipo,
                    coppie,
                    percorso
                )
            )

            if n_file > 0:
                log(
                    f"COMPLESSIVO CREATO: "
                    f"{percorso}"
                )

                log(
                    f"  Modelpoint accodati: "
                    f"{n_file}"
                )

                log(
                    f"  Righe totali: "
                    f"{n_righe:,}"
                )

        except Exception as e:
            log(
                f"ERRORE COMPLESSIVO {tipo}: "
                f"{e}"
            )

            errori.append(
                (
                    f"COMPLESSIVO {tipo}",
                    str(e)
                )
            )

    log("FASE 5 COMPLETATA")

    # ========================================================
    # RIEPILOGO FINALE
    # ========================================================

    log("\n" + "=" * 60)
    log("ELABORAZIONE TERMINATA")
    log("=" * 60)

    log(f"Nuovi RPT: {nuovi}")
    log(f"RPT gia' presenti: {saltati}")

    log(
        f"Righe modificate: "
        f"{righe_modificate:,}"
    )

    log(
        f"Report TXT: {report}"
    )

    log(
        f"Esito CHECK: {esito_check}"
    )

    log(
        f"Errori elaborazione: "
        f"{len(errori)}"
    )

    log(
        f"Tempo totale: "
        f"{perf_counter() - INIZIO:.1f} secondi"
    )

    log("=" * 60)


if __name__ == "__main__":
    main()
