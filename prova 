
from pathlib import Path
from decimal import Decimal, ROUND_HALF_UP, localcontext
from collections import defaultdict
from datetime import datetime
from time import perf_counter

from openpyxl import Workbook
from openpyxl.cell import WriteOnlyCell
from openpyxl.styles import Font, PatternFill
from openpyxl.utils import get_column_letter


# ============================================================
# 1. CONFIGURAZIONE
# ============================================================

INPUT = Path("input")
OUTPUT = Path("output")

XLSX_ORIGINALI = OUTPUT / "xlsx_originali"
XLSX_MODIFICATI = OUTPUT / "xlsx_modificati"

# Numero massimo di decimali nel nuovo TOPUP_PREM.
# Da validare con Prophet su alcuni file di prova.
DECIMALI_TOPUP = 9

# Messaggi di avanzamento
OGNI_RIGHE = 10000

# Numero massimo di righe di un foglio Excel
MAX_RIGHE_EXCEL = 1048576

PERCENTUALI = {
    "PTEVPJ": Decimal("0.025034000"),
    "PTEVPJ_75": Decimal("0.025034000"),
    "PTPVPI": Decimal("0.004571000"),
    "PTPVPK": Decimal("0.004571000"),
    "PTPMUG": Decimal("0.024120000"),
    "PTEVPK": Decimal("0.031878501"),
    "PTPVPL": Decimal("0.004404654"),
    "PTQVPA": Decimal("0.000000000"),
    "PTOP18": Decimal("0.004500000"),
    "PTOP19": Decimal("0.004500000"),
    "PTOP21": Decimal("0.000000000"),
    "PTRVPA": Decimal("0.033802741"),
    "PTPVPM": Decimal("0.004200000"),
    "PTOP22": Decimal("0.000000000"),
    "PTPVPN": Decimal("0.004710510"),
}

COLONNE_MU = [
    f"MF_INIT_UNITS({i})"
    for i in range(1, 7)
]

NUMERICHE = {
    "INIT_UNITS",
    "TOPUP_PREM",
    *COLONNE_MU
}

INIZIO = perf_counter()


# ============================================================
# 2. UTILITA'
# ============================================================

def log(messaggio):
    ora = datetime.now().strftime("%H:%M:%S")
    secondi = perf_counter() - INIZIO

    print(
        f"[{ora}] [+{secondi:.1f}s] {messaggio}",
        flush=True
    )


def tipo_modelpoint(nome):
    nome = nome.upper()

    mo = "MO" in nome
    mu = "MU" in nome

    if mo and not mu:
        return "MO"

    if mu and not mo:
        return "MU"

    raise ValueError(
        f"Nome ambiguo per MO/MU: {nome}"
    )


def dec(valore):
    valore = valore.strip()

    if not valore:
        return Decimal("0")

    return Decimal(valore)


def testo(campo):
    # ASCII compatibile con UTF-8.
    # In caso di codifica diversa, il programma
    # segnala l'errore anziche' alterare il file.
    return campo.decode("utf-8").strip()


def separa_riga(riga):
    if riga.endswith(b"\r\n"):
        return riga[:-2], b"\r\n"

    if riga.endswith(b"\n"):
        return riga[:-1], b"\n"

    if riga.endswith(b"\r"):
        return riga[:-1], b"\r"

    return riga, b""


def leggi_righe(percorso):
    return percorso.read_bytes().splitlines(
        keepends=True
    )


def leggi_struttura(righe):
    for numero, riga in enumerate(righe):
        contenuto, _ = separa_riga(riga)

        colonne = [
            testo(x).upper()
            for x in contenuto.split(b",")
        ]

        if (
            "PRODOTTO" in colonne
            and "TOPUP_PREM" in colonne
        ):
            if len(colonne) != len(set(colonne)):
                raise ValueError(
                    "Intestazioni duplicate"
                )

            return numero, colonne

    raise ValueError(
        "Intestazione con PRODOTTO "
        "e TOPUP_PREM non trovata"
    )


def trova_indici(colonne, tipo):
    richieste = [
        "PRODOTTO",
        "TOPUP_PREM"
    ]

    if tipo == "MO":
        richieste.append("INIT_UNITS")
    else:
        richieste.extend(COLONNE_MU)

    mancanti = [
        x for x in richieste
        if x not in colonne
    ]

    if mancanti:
        raise ValueError(
            "Colonne mancanti: "
            + ", ".join(mancanti)
        )

    ip = colonne.index("PRODOTTO")
    it = colonne.index("TOPUP_PREM")

    if tipo == "MO":
        iu = [colonne.index("INIT_UNITS")]
    else:
        iu = [
            colonne.index(x)
            for x in COLONNE_MU
        ]

    return ip, it, iu


def nome_libero(nome):
    percorso = OUTPUT / nome
    contatore = 2

    while percorso.exists():
        p = Path(nome)

        percorso = OUTPUT / (
            f"{p.stem}_{contatore}{p.suffix}"
        )

        contatore += 1

    return percorso


def salva_excel_sicuro(wb, percorso):
    # Non sovrascrive file esistenti.
    # In caso di errore rimuove soltanto
    # il file parziale appena creato.

    creato = False

    try:
        with percorso.open("xb") as f:
            creato = True
            wb.save(f)

    except Exception:
        if creato and percorso.exists():
            percorso.unlink()

        raise


def nuovo_topup(units, percentuale):
    with localcontext() as ctx:
        ctx.prec = 50

        valore = units * percentuale

        quant = Decimal("1").scaleb(
            -DECIMALI_TOPUP
        )

        valore = valore.quantize(
            quant,
            rounding=ROUND_HALF_UP
        )

        return (
            f"{valore:.{DECIMALI_TOPUP}f}"
        )


def cambia_solo_topup(campo, nuovo):
    # Conserva spazi prima e dopo il valore.

    sinistra = len(campo) - len(
        campo.lstrip(b" ")
    )

    destra = len(campo) - len(
        campo.rstrip(b" ")
    )

    return (
        b" " * sinistra
        + nuovo.encode("ascii")
        + b" " * destra
    )


def formato_intestazione(ws):
    for cella in ws[1]:
        cella.font = Font(
            bold=True,
            color="FFFFFF"
        )

        cella.fill = PatternFill(
            fill_type="solid",
            fgColor="17365D"
        )

    ws.freeze_panes = "A2"


def valore_excel(campo, colonna):
    valore = testo(campo)

    if colonna in NUMERICHE:
        try:
            return float(dec(valore))
        except Exception:
            return valore

    return valore


# ============================================================
# 3. MODIFICA RPT
# ============================================================

def modifica_rpt(originale, destinazione):
    tipo = tipo_modelpoint(originale.stem)

    righe = leggi_righe(originale)
    header, colonne = leggi_struttura(righe)

    ip, it, iu = trova_indici(colonne, tipo)

    nuove_righe = list(righe)

    statistiche = defaultdict(
        lambda: {
            "righe": 0,
            "prima": Decimal("0"),
            "dopo": Decimal("0")
        }
    )

    contatore = 0

    for i in range(header + 1, len(righe)):
        contenuto, fine = separa_riga(
            righe[i]
        )

        if not contenuto.strip():
            continue

        campi = contenuto.split(b",")

        if len(campi) != len(colonne):
            raise ValueError(
                f"Riga {i+1}: numero colonne "
                "non coerente"
            )

        prodotto = testo(campi[ip])

        if prodotto not in PERCENTUALI:
            continue

        try:
            units = sum(
                (
                    dec(testo(campi[j]))
                    for j in iu
                ),
                Decimal("0")
            )

            prima = dec(testo(campi[it]))

            nuovo = nuovo_topup(
                units,
                PERCENTUALI[prodotto]
            )

            dopo = Decimal(nuovo)

            campi[it] = cambia_solo_topup(
                campi[it],
                nuovo
            )

            nuove_righe[i] = (
                b",".join(campi) + fine
            )

            s = statistiche[prodotto]

            s["righe"] += 1
            s["prima"] += prima
            s["dopo"] += dopo

            contatore += 1

            if contatore % OGNI_RIGHE == 0:
                log(
                    f"  RPT: {contatore:,} "
                    "righe modificate"
                )

        except Exception as e:
            raise ValueError(
                f"Riga {i+1}, prodotto "
                f"{prodotto}: {e}"
            )

    # Non sovrascrive mai l'originale.
    with destinazione.open("xb") as f:
        f.write(b"".join(nuove_righe))

    return statistiche, contatore


# ============================================================
# 4. REPORT TXT
# ============================================================

def crea_report(statistiche, errori,
                nuovi, saltati, righe_totali):

    percorso = nome_libero(
        "report_modifiche.txt"
    )

    with percorso.open(
        "x",
        encoding="utf-8"
    ) as f:

        f.write("REPORT MODIFICHE MODELPOINT\n")
        f.write("=" * 60 + "\n")

        f.write(
            f"Data: "
            f"{datetime.now():%d/%m/%Y %H:%M:%S}\n"
        )

        f.write(f"RPT creati: {nuovi}\n")
        f.write(
            f"RPT gia' esistenti: {saltati}\n"
        )
        f.write(
            f"Righe modificate: {righe_totali}\n"
        )
        f.write(
            f"Decimali TOPUP: {DECIMALI_TOPUP}\n"
        )
        f.write(
            f"Errori elaborazione: "
            f"{len(errori)}\n\n"
        )

        f.write(
            "NOTA: le statistiche riguardano "
            "i nuovi RPT creati in questa esecuzione.\n"
        )

        for prodotto in sorted(statistiche):
            elementi = statistiche[prodotto]

            f.write("\n" + "-" * 60 + "\n")
            f.write(
                f"TARIFFA: {prodotto}\n"
            )

            f.write(
                f"PERCENTUALE EJ: "
                f"{PERCENTUALI[prodotto] * 100}%\n"
            )

            somma_righe = 0
            somma_prima = Decimal("0")
            somma_dopo = Decimal("0")

            for nome, tipo, s in elementi:
                f.write(
                    f"\nMODELPOINT: {nome} ({tipo})\n"
                )

                f.write(
                    f"  Righe: {s['righe']}\n"
                )

                f.write(
                    f"  TOPUP originale: "
                    f"{s['prima']}\n"
                )

                f.write(
                    f"  TOPUP modificato: "
                    f"{s['dopo']}\n"
                )

                somma_righe += s["righe"]
                somma_prima += s["prima"]
                somma_dopo += s["dopo"]

            f.write(
                f"\nTOTALE RIGHE: {somma_righe}\n"
            )
            f.write(
                f"TOTALE TOPUP ORIGINALE: "
                f"{somma_prima}\n"
            )
            f.write(
                f"TOTALE TOPUP MODIFICATO: "
                f"{somma_dopo}\n"
            )

        if errori:
            f.write("\n\nERRORI\n")

            for nome, errore in errori:
                f.write(
                    f"{nome}: {errore}\n"
                )

    return percorso


# ============================================================
# 5. CHECK STRUTTURALE
# ============================================================

def verifica_struttura(old, new, nome, tipo):
    if len(old) != len(new):
        raise ValueError(
            f"{nome}: numero righe diverso"
        )

    header, colonne = leggi_struttura(old)
    header_n, colonne_n = leggi_struttura(new)

    if (
        header != header_n
        or colonne != colonne_n
    ):
        raise ValueError(
            f"{nome}: intestazioni diverse"
        )

    ip, it, iu = trova_indici(
        colonne, tipo
    )

    for i in range(len(old)):
        a, fine_a = separa_riga(old[i])
        b, fine_b = separa_riga(new[i])

        if i <= header:
            if old[i] != new[i]:
                raise ValueError(
                    f"{nome}: intestazione o "
                    f"preambolo modificato, riga {i+1}"
                )

            continue

        if not a.strip():
            if old[i] != new[i]:
                raise ValueError(
                    f"{nome}: riga vuota "
                    f"modificata, riga {i+1}"
                )

            continue

        ca = a.split(b",")
        cb = b.split(b",")

        if (
            len(ca) != len(colonne)
            or len(cb) != len(colonne)
        ):
            raise ValueError(
                f"{nome}: numero colonne "
                f"diverso alla riga {i+1}"
            )

        if fine_a != fine_b:
            raise ValueError(
                f"{nome}: fine riga modificato "
                f"alla riga {i+1}"
            )

        for j in range(len(colonne)):
            if j != it and ca[j] != cb[j]:
                raise ValueError(
                    f"{nome}: colonna "
                    f"{colonne[j]} modificata "
                    f"alla riga {i+1}"
                )

        prodotto = testo(ca[ip])

        if (
            prodotto not in PERCENTUALI
            and ca[it] != cb[it]
        ):
            raise ValueError(
                f"{nome}: TOPUP modificato "
                f"per tariffa non prevista "
                f"alla riga {i+1}"
            )

    return header, colonne, ip, it, iu


